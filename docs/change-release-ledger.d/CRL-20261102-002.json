{
  "schema_version": 1,
  "crl": "CRL-20261102-002",
  "repository": "root",
  "title": "Manual cleaning task password field applicability",
  "request": "Make the web manual-create form submit only password fields that apply to the selected cleaning task type.",
  "outcome": "Checkout, check-in, stayover, and combined task creation now preserve applicable blank values while omitting inapplicable fields, with duplicate-submit and failure-retention coverage.",
  "implementation": [
    "Derive the manual-create payload from the selected task type instead of sending both password fields for every task.",
    "Keep applicable empty inputs as explicit null values and omit fields that do not apply.",
    "Add rendered-form and helper-level regression coverage for all four task-type combinations."
  ],
  "impact_dependencies": [
    "API shape is unchanged; the client now conforms to the existing applicability contract.",
    "No database, migration, environment, native, package-lock, or production-data change.",
    "No dependency outside this repository is required for the web correction."
  ],
  "validation": [
    "Incremental ledger unit tests cover missing registration, wrong paths, invalid schema, exact success, and append-only lineage.",
    "Web helper, rendered manual-create QA, lint, unit tests, build, and repository gates are required before release."
  ],
  "risks": [
    "A missing, malformed, stale, duplicated, or over-broad incremental registration fails the ledger audit.",
    "The historical ledger remains byte-for-byte unchanged and is not included in this change."
  ],
